SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: set CSRF_TRUSTED_ORIGINS when serving through a tunnel / proxy.
# CSRF_TRUSTED_ORIGINS=https://your-preview-host.example.com

# Comment out / empty DB_NAME to use the local SQLite database (db.sqlite3) during development.
DB_NAME=book_bridge
