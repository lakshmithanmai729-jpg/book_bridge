# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Absolute base URL used inside emails (verification + password reset links).
SITE_URL=http://127.0.0.1:8000

# Set when running behind a tunnel / proxy
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ---------------------------------------------------------------------------
# Database
#   Leave DB_NAME empty to use the local SQLite file (db.sqlite3) — the
#   quickest way to run the project for development.
#   Fill these in to use MySQL.
# ---------------------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# mysql (default) or postgres — must match the driver installed in requirements.txt
DB_ENGINE=mysql

# ---------------------------------------------------------------------------
# Email
#   Development: console backend prints emails to the terminal (default).
#   Production: switch to SMTP (e.g. Gmail app password, SendGrid, Mailgun).
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BookBridge <no-reply@bookbridge.local>

# Set to True to stop "new chat message" notification emails.
DISABLE_CHAT_EMAILS=False

# ---------------------------------------------------------------------------
# Demo deployment (used by render.yaml)
# ---------------------------------------------------------------------------
# DEMO_MODE=1 fills the marketplace with 16 demo books, photos and chats even
# with DEBUG=False. The demo accounts get unusable passwords, so nobody can
# sign in as demo/arjun/priya/rahul.
DEMO_MODE=False

# Where uploaded book covers are stored.
#   filesystem — local media/ folder (development)
#   db         — rows in the database, so covers survive a restart on a free host
MEDIA_STORAGE=filesystem

# Alternative to DB_NAME / DB_*: one connection string. Used by Render, Neon,
# Railway, Supabase… Query options such as ?sslmode=require are honoured.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Production hardening (only used when DEBUG=False)
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
